# 运行环境 / Runtime environment
AGENT_ENVIRONMENT=development

# 模型配置 / Model configuration
AGENT_MODEL__PROVIDER=anthropic
AGENT_MODEL__MODEL_ID=replace-with-model-id
AGENT_MODEL__API_KEY=replace-with-api-key
AGENT_MODEL__BASE_URL=replace-with-provider-base-url
AGENT_MODEL__TEMPERATURE=0
AGENT_MODEL__TIMEOUT_SECONDS=60
AGENT_MODEL__MAX_CONCURRENCY=1
AGENT_MODEL__QUOTA_SCOPE=moonshot-personal

# 备用模型，可使用具有独立额度的 Provider / Optional fallback model
# AGENT_FALLBACK_MODEL__PROVIDER=deepseek
# AGENT_FALLBACK_MODEL__MODEL_ID=deepseek-v4-flash
# AGENT_FALLBACK_MODEL__API_KEY=replace-with-fallback-api-key
# AGENT_FALLBACK_MODEL__BASE_URL=https://api.deepseek.com
# AGENT_FALLBACK_MODEL__TEMPERATURE=0
# AGENT_FALLBACK_MODEL__TIMEOUT_SECONDS=60
# AGENT_FALLBACK_MODEL__MAX_CONCURRENCY=10
# AGENT_FALLBACK_MODEL__QUOTA_SCOPE=deepseek-personal

# 模型网关 / Model gateway
AGENT_MODEL_GATEWAY__ENABLED=true
AGENT_MODEL_GATEWAY__MAX_RETRIES=2
AGENT_MODEL_GATEWAY__RATE_LIMIT_MAX_RETRIES=1
AGENT_MODEL_GATEWAY__RETRY_BASE_DELAY_SECONDS=1
AGENT_MODEL_GATEWAY__RETRY_MAX_DELAY_SECONDS=16
AGENT_MODEL_GATEWAY__RETRY_JITTER_SECONDS=0.5
AGENT_MODEL_GATEWAY__LOCK_DIRECTORY=/tmp/extensible-agent-template-model-locks

# 错误恢复 / Error recovery
AGENT_ERROR_RECOVERY__INITIAL_MAX_OUTPUT_TOKENS=4096
AGENT_ERROR_RECOVERY__MAX_OUTPUT_TOKENS=16384
AGENT_ERROR_RECOVERY__OUTPUT_TOKEN_MULTIPLIER=2
AGENT_ERROR_RECOVERY__MAX_OUTPUT_RETRIES=1
AGENT_ERROR_RECOVERY__TOOL_TIMEOUT_SECONDS=30

# 日志配置 / Logging configuration
AGENT_LOGGING__LEVEL=INFO
AGENT_LOGGING__FORMAT=console

# Agent Loop
AGENT_AGENT_LOOP__MAX_ITERATIONS=16

# Agent 运行目录 / Agent runtime paths
AGENT_PATHS__WORKSPACE_ROOT=.
AGENT_PATHS__KNOWLEDGE_ROOT=src/business/knowledge_assistant/knowledge
AGENT_PATHS__ARTIFACT_ROOT=artifacts
AGENT_PATHS__USER_DATA_ROOT=users

# Context Compact（按实际模型窗口调整）/ Context compaction
AGENT_CONTEXT_COMPACT__ENABLED=true
AGENT_CONTEXT_COMPACT__MAX_CONTEXT_CHARACTERS=400000
AGENT_CONTEXT_COMPACT__MAX_MESSAGES=120
AGENT_CONTEXT_COMPACT__KEEP_RECENT_MESSAGES=20
AGENT_CONTEXT_COMPACT__KEEP_RECENT_TOOL_RESULTS=3
AGENT_CONTEXT_COMPACT__MAX_TOOL_RESULT_CHARACTERS=40000
AGENT_CONTEXT_COMPACT__TOOL_RESULT_PREVIEW_CHARACTERS=2000
AGENT_CONTEXT_COMPACT__MICRO_COMPACT_MIN_CHARACTERS=500
AGENT_CONTEXT_COMPACT__MAX_SUMMARY_SOURCE_CHARACTERS=120000
AGENT_CONTEXT_COMPACT__MAX_SUMMARY_CHARACTERS=8000
AGENT_CONTEXT_COMPACT__MAX_REACTIVE_RETRIES=1

# 跨会话 Memory / Cross-session memory
AGENT_MEMORY__ENABLED=true
AGENT_MEMORY__MAX_MEMORIES=200
AGENT_MEMORY__MAX_SELECTED_MEMORIES=5
AGENT_MEMORY__MAX_MEMORY_CONTENT_CHARACTERS=4096
AGENT_MEMORY__MAX_MEMORY_INDEX_CHARACTERS=25000

# SQLite Checkpoint / SQLite Checkpoint
AGENT_CHECKPOINT__USER_DATABASE_FILENAME=checkpoints.sqlite3
AGENT_CHECKPOINT__CONVERSATION_DATABASE_PATH=.agent/conversations.sqlite3
AGENT_CHECKPOINT__BUSY_TIMEOUT_SECONDS=5

# 用户级 Task System / User-scoped Task System
AGENT_TASK_SYSTEM__DATABASE_FILENAME=tasks.sqlite3
AGENT_TASK_SYSTEM__BUSY_TIMEOUT_SECONDS=5

# RAG（默认关闭；启用后需要 PostgreSQL + pgvector）
AGENT_RAG__ENABLED=false
AGENT_RAG__DATABASE_URL=postgresql+psycopg://agent:agent@127.0.0.1:5432/agent
AGENT_RAG__COLLECTION_NAME=knowledge_assistant
AGENT_RAG__KNOWLEDGE_BASE_ID=knowledge_assistant
AGENT_RAG__EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AGENT_RAG__EMBEDDING_DIMENSION=512
AGENT_RAG__TOP_K=5
AGENT_RAG__SCORE_THRESHOLD=0.35
AGENT_RAG__MAX_CONTEXT_CHARACTERS=12000
AGENT_RAG__CHUNK_SIZE=1200
AGENT_RAG__CHUNK_OVERLAP=150

# MCP is opt-in. SERVERS is a JSON object keyed by server name.
AGENT_MCP__ENABLED=false
AGENT_MCP__DISCOVERY_TIMEOUT_SECONDS=10
# AGENT_MCP__SERVERS={"local_demo":{"transport":"stdio","command":"python","args":["/absolute/path/to/server.py"]}}

# 可选数据库连接 / Optional database connection
AGENT_DATABASE_URL=replace-with-database-url
